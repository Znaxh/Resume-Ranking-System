# Copy to `backend/.env` to override (optional; Docker Compose loads this file as defaults).
# `cp backend/.env.example backend/.env` then edit.

SECRET_KEY=change-me-in-production
FLASK_ENV=production
DEBUG=false
# Optional: Redis for v2 caching (same default as local dev if unset in code)
# REDIS_URL=redis://redis:6379/0
